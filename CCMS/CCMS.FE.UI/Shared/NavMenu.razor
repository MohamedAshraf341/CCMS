@using CCMS.FE.UI.Components.User
<PersonCard Style="background-color: var(--mud-palette-drawer-background);color: var(--mud-palette-drawer-text);"/>
<MudDivider Class="mb-4" />
<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">@sharedResources[Common.Keys.DashBoard.NavBar.Home]</MudNavLink>
    @if (User.SystemType == Common.Const.SystemType.System && authService.UserHasOneOfRole(Common.Const.Roles.Admin.Name))
    {
        <MudNavLink Href="/Restaurants" Icon="@Icons.Material.Filled.List" Match="NavLinkMatch.All">@sharedResources[Common.Keys.DashBoard.NavBar.Restaurants]</MudNavLink>
    }
    @if (User.SystemType == Common.Const.SystemType.System && authService.UserHasOneOfRole(Common.Const.Roles.Admin.Name))
    {
        <MudNavLink Href="/Branches" Icon="@Icons.Material.Filled.FoodBank" Match="NavLinkMatch.All">@sharedResources[Common.Keys.DashBoard.NavBar.Branches]</MudNavLink>
    }
    @if (authService.UserHasOneOfRole(Common.Const.Roles.Admin.Name))
    {
        <MudNavLink Href="/MenuItems" Icon="@Icons.Material.Filled.ListAlt" Match="NavLinkMatch.All">@sharedResources[Common.Keys.DashBoard.NavBar.MenuItems]</MudNavLink>
    }
    @if (!authService.UserHasOneOfRole(Common.Const.Roles.SuperAdmin.Name))
    {
        <MudNavLink Href="/Orders" Icon="@Icons.Material.Filled.AddIcCall" Match="NavLinkMatch.All">@sharedResources[Common.Keys.DashBoard.NavBar.Orders]</MudNavLink>
    }
    @if (authService.UserHasOneOfRole(Common.Const.Roles.Admin.Name))
    {
        <MudNavLink Href="/Clients" Icon="@Icons.Material.Filled.SupervisedUserCircle" Match="NavLinkMatch.All">@sharedResources[Common.Keys.DashBoard.NavBar.Clients]</MudNavLink>
    }
    @if (authService.UserHasOneOfRole(Common.Const.Roles.Admin.Name, Common.Const.Roles.SuperAdmin.Name))
    {
        <MudNavLink Href="/Users" Icon="@Icons.Material.Filled.People" Match="NavLinkMatch.All">@sharedResources[Common.Keys.DashBoard.NavBar.Users]</MudNavLink>
    }
</MudNavMenu>

 